 #if PICO_ON_DEVICE
@@ -1086,6 +1157,208 @@ static void __not_in_flash_func(free_buffer_callback)() {
 }
 #endif
 
+#if SC26_BOARD
+// ---------------------------------------------------------------- SC26 panel pump (core 1)
+// A 60 Hz tick starts a frame (exactly where scanvideo started a VGA frame, so wipes and
+// palette flashes keep their speed). The tick is a dummy DMA transfer paced by a DMA pacing
+// timer, so the whole pump runs off DMA_IRQ_0 (the timer-alarm version stopped ticking on the
+// badge after a few seconds). Each finished line DMA starts the next line and builds
+// the one after it, so lines are generated just ahead of the QSPI transfer. Everything here
+// runs from RAM because it keeps going while core 0 writes save games to flash.
+// Overlay patches (status bar, HUD, menus) can write a little before and past the 320 visible
+// pixels - the VGA buffers had header/trailer words that absorbed it. Without slack those
+// writes ran into the pump's own variables right after these buffers and stopped the frame
+// tick as soon as a level started. 64 bytes in front, 256 behind, per line.
+#define SC26_LB_PRE  16
+#define SC26_LB_POST 64
+static uint32_t __aligned(4) sc26_lbuf_raw[2][SC26_LB_PRE + SCREENWIDTH / 2 + SC26_LB_POST];
+#define sc26_lbuf_line(i) (&sc26_lbuf_raw[(i)][SC26_LB_PRE])
+static volatile bool sc26_busy;
+static int sc26_sent, sc26_fill;
+static int sc26_pace_dma = -1;
+static uint32_t sc26_pace_count, sc26_pace_word;
+static uint32_t sc26_frame_t0;            // when the current frame started (us)
+volatile uint32_t sc26_frames, sc26_recoveries, sc26_core1_pc, sc26_c1_last_alarm_us;
+void sc26_fill_line(uint32_t *dest, int scanline);
+
+// pump state for crash reports: busy | line being sent | next line to build
+void sc26_pump_regs(uint32_t *out) {          // DMA / pump registers for the freeze report
+    out[0] = dma_hw->inte0;
+    out[1] = dma_hw->ints0;
+    out[2] = dma_hw->intr;
+    out[3] = dma_hw->ch[sc26_lcd_dma].ctrl_trig;
+    out[4] = dma_hw->ch[sc26_lcd_dma].transfer_count;
+    out[5] = sc26_pace_dma >= 0 ? dma_hw->ch[sc26_pace_dma].ctrl_trig : 0;
+    out[6] = sc26_pace_dma >= 0 ? dma_hw->ch[sc26_pace_dma].transfer_count : 0;
+    out[7] = ((uint32_t)sc26_lcd_dma << 8) | (uint32_t)(sc26_pace_dma & 0xFF);
+    out[8] = sc26_frame_t0;
+}
+
+uint32_t sc26_pump_state(void) {
+    return ((uint32_t)sc26_busy << 31) | ((uint32_t)(sc26_sent & 0x7FFF) << 16) | (uint32_t)(sc26_fill & 0xFFFF);
+}
+
+static void __not_in_flash_func(sc26_frame_start)(void) {
+    if (sc26_busy) {
+        // A frame normally takes ~4 ms. If one has been "in flight" for 100 ms an interrupt
+        // went missing: reset the panel link instead of freezing the game (core 0 would wait
+        // forever for the frame buffer to be released).
+        if (timer_hw->timerawl - sc26_frame_t0 < 100000) return;
+        sc26_lcd_recover();
+        sc26_recoveries++;
+    }
+    sc26_busy = true;
+    sc26_frame_t0 = timer_hw->timerawl;
+    new_frame_stuff();
+    sc26_lcd_begin_pixels(SC26_VIEW_X, SC26_VIEW_Y, SCREENWIDTH, SCREENHEIGHT);
+    sc26_fill_line(sc26_lbuf_line(0), 0);
+    sc26_sent = 0;
+    sc26_lcd_start_dma(sc26_lbuf_line(0), SCREENWIDTH * 2);
+    sc26_fill_line(sc26_lbuf_line(1), 1);
+    sc26_fill = 2;
+}
+
+static inline void __not_in_flash_func(sc26_pace_restart)(void) {
+    dma_channel_set_trans_count(sc26_pace_dma, sc26_pace_count, true);
+}
+
+void __attribute__((used)) __not_in_flash_func(sc26_dma_isr_c)(uint32_t *frame) {
+    uint32_t st = dma_hw->ints0;
+    if (st & (1u << sc26_lcd_dma)) {
+        dma_hw->ints0 = 1u << sc26_lcd_dma;
+        if (++sc26_sent >= SCREENHEIGHT) {
+            sc26_lcd_end_pixels();
+            sc26_busy = false;
+            if (++sc26_frames == 60) watchdog_hw->scratch[0] = (watchdog_hw->scratch[0] & ~0x00FF0000u) | (8u << 16);
+        } else {
+            sc26_lcd_start_dma(sc26_lbuf_line(sc26_sent & 1), SCREENWIDTH * 2);
+            if (sc26_fill < SCREENHEIGHT) {
+                sc26_fill_line(sc26_lbuf_line(sc26_fill & 1), sc26_fill);
+                sc26_fill++;
+            }
+        }
+    }
+    if (st & (1u << sc26_pace_dma)) {       // 60 Hz tick
+        dma_hw->ints0 = 1u << sc26_pace_dma;
+        sc26_core1_pc = frame[6];           // where core 1's own work was when we interrupted it
+        sc26_c1_last_alarm_us = timer_hw->timerawl;
+        sc26_pace_restart();
+        sc26_frame_start();
+    }
+}
+
+// naked entry so the C part can see the exception frame (core 1 threads run on MSP)
+static void __attribute__((naked)) __not_in_flash_func(sc26_dma_isr)(void) {
+    __asm volatile(
+        "tst lr, #4          \n"
+        "ite eq              \n"
+        "mrseq r0, msp       \n"
+        "mrsne r0, psp       \n"
+        "b sc26_dma_isr_c    \n");
+}
+
+// a dummy word-to-word DMA paced by a DMA timer: its completion is the 60 Hz frame tick
+static void sc26_pace_init(void) {
+    int t = dma_claim_unused_timer(true);
+    dma_timer_set_fraction((uint)t, 1, 0xFFFF);                 // clk_sys / 65535 per transfer
+    uint32_t rate = clock_get_hz(clk_sys) / 0xFFFFu;
+    sc26_pace_count = (rate + 30) / 60;
+    sc26_pace_dma = dma_claim_unused_channel(true);
+    dma_channel_config c = dma_channel_get_default_config((uint)sc26_pace_dma);
+    channel_config_set_transfer_data_size(&c, DMA_SIZE_32);
+    channel_config_set_read_increment(&c, false);
+    channel_config_set_write_increment(&c, false);
+    channel_config_set_dreq(&c, dma_get_timer_dreq((uint)t));
+    dma_channel_configure((uint)sc26_pace_dma, &c, &sc26_pace_word, &sc26_pace_word, sc26_pace_count, false);
+    dma_channel_set_irq0_enabled((uint)sc26_pace_dma, true);
+}
+
+// LED ring: each LED takes the colour of the 3D view in its direction; damage / pickup /
+// radiation-suit palette flashes tint the whole ring. Called from the input poll (core 0).
+void sc26_ambient(void) {
+    const uint8_t *fb = frame_buffer[display_frame_index];
+    int pal = sc26_palnum;
+    // sampling direction for ring position k (k = 0 nose, then down the right side of the
+    // SAINTCON rocket, across the fins and up the left): -90, -28, 0, 26, 53, 127, 154, 180,
+    // 208 degrees, as in SC26 OS ambient.c. Q10.
+    static const int16_t kcos[9] = { 0, 904, 1024, 920, 616, -616, -920, -1024, -904 };
+    static const int16_t ksin[9] = { -1024, -481, 0, 449, 818, 818, 449, 0, -481 };
+    for (int k = 0; k < 9; k++) {
+        int cx = 160 + 140 * kcos[k] / 1024, cy = MAIN_VIEWHEIGHT / 2 + (MAIN_VIEWHEIGHT / 2 - 14) * ksin[k] / 1024;
+        int r = 0, g = 0, b = 0;
+        for (int dy = -8; dy <= 8; dy += 8)
+            for (int dx = -8; dx <= 8; dx += 8) {
+                int x = cx + dx, y = cy + dy;
+                if (x < 0) x = 0;
+                if (x >= SCREENWIDTH) x = SCREENWIDTH - 1;
+                if (y < 0) y = 0;
+                if (y >= MAIN_VIEWHEIGHT) y = MAIN_VIEWHEIGHT - 1;
+                uint16_t be = palette[fb[y * SCREENWIDTH + x]];
+                uint16_t c = (uint16_t)((be >> 8) | (be << 8));
+                r += (c >> 11) << 3; g += ((c >> 5) & 63) << 2; b += (c & 31) << 3;
+            }
+        r /= 9; g /= 9; b /= 9;
+        // saturate a little and keep it dim: the ring is right next to your eyes
+        int m = (r + g + b) / 3;
+        r = m + (r - m) * 3 / 2; g = m + (g - m) * 3 / 2; b = m + (b - m) * 3 / 2;
+        if (pal >= 1 && pal <= 8) { int t = pal * 28; r += (255 - r) * t / 255; g -= g * t / 255; b -= b * t / 255; }
+        else if (pal >= 9 && pal <= 12) { int t = (pal - 8) * 40; r += (255 - r) * t / 255; g += (200 - g) * t / 255; b -= b * t / 255; }
+        else if (pal == 13) { g += (255 - g) / 3; }
+        r = r < 0 ? 0 : r > 255 ? 255 : r;
+        g = g < 0 ? 0 : g > 255 ? 255 : g;
+        b = b < 0 ? 0 : b > 255 ? 255 : b;
+        sc26_set_led_target(k, (uint8_t)(r * 45 / 100), (uint8_t)(g * 45 / 100), (uint8_t)(b * 45 / 100));
+    }
+    sc26_leds_update();
+}
+
+// Put a handler straight into the (RAM) vector table. irq_set_exclusive_handler() hard-asserts
+// when the slot isn't the default stub, which killed the first hardware run; if that happens
+// we note what was there (for DOOMLOG.TXT via SC26 OS) and take the slot anyway.
+static void sc26_install_irq(uint num, irq_handler_t handler) {
+    extern uint32_t __vectors[];
+    volatile uint32_t *vt = (volatile uint32_t *)scb_hw->vtor;
+    uint32_t cur = vt[16 + num], dflt = __vectors[16 + num];
+    if (cur != dflt && cur != (uint32_t)handler) {
+        watchdog_hw->scratch[2] = 0xA0000000u | num;
+        watchdog_hw->scratch[3] = cur;
+    }
+    vt[16 + num] = (uint32_t)handler;
+    __dsb(); __isb();
+}
+
+uint32_t *sc26_c1_stack_lo, *sc26_c1_stack_hi;
+
+static void core1() {
+    // paint the unused part of our stack so a freeze report can say how deep it ever got
+    {
+        uint32_t *sp;
+        __asm volatile("mov %0, sp" : "=r"(sp));
+        sc26_c1_stack_hi = sp - 16;
+        sc26_c1_stack_lo = sp - PICO_CORE1_STACK_SIZE / 4 + 24;
+        for (uint32_t *p = sc26_c1_stack_lo; p < sc26_c1_stack_hi; p++) *p = 0x5C26C0DEu;
+    }
+    // a doorbell from core 0 becomes an NMI here, so a freeze report can say where core 1 was
+    // even if it is stuck with interrupts off
+    eppb_hw->nmi_mask[0] |= 1u << SIO_IRQ_BELL;
+    sc26_stage(1, 1);
+    sc26_lcd_init();
+    sc26_stage(1, 2);
+    dma_channel_set_irq0_enabled(sc26_lcd_dma, true);
+    sc26_install_irq(DMA_IRQ_0, sc26_dma_isr);
+    irq_set_enabled(DMA_IRQ_0, true);
+    sc26_stage(1, 4);
+    sc26_pace_init();
+    sc26_stage(1, 5);
+    sc26_pace_restart();
+    sc26_stage(1, 6);
+    sem_release(&core1_launch);
+    sc26_stage(1, 7);
+    while (true) {
+        pd_core1_loop();
+    }
+}
+#else
 //static semaphore_t init_sem;
